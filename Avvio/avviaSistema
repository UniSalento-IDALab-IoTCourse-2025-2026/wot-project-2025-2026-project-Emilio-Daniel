#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EDGE_DIR="$PROJECT_DIR/edge_node"
CONFIG_FILE="$EDGE_DIR/config/edge.yml"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "ERRORE: manca edge_node/config/edge.yml"
  echo "Crea il file reale partendo da edge_node/config/edge.example.yml e inserisci token/config locali."
  exit 1
fi

if [[ -x "$PROJECT_DIR/.venv/bin/python" ]]; then
  PYTHON_EXE="$PROJECT_DIR/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_EXE="python3"
else
  PYTHON_EXE="python"
fi

cd "$EDGE_DIR"
exec "$PYTHON_EXE" -m edge_stack.cli --config config/edge.yml "$@"
