#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
EDGE_DIR="$PROJECT_DIR/edge_node"
CONFIG_FILE="$EDGE_DIR/config/edge.yml"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "ERRORE: manca edge_node/config/edge.yml"
  echo "Crea il file reale partendo da edge_node/config/edge.example.yml e inserisci token/config locali."
  exit 1
fi

if [[ -x "$PROJECT_DIR/.venv/bin/python" ]]; then
  PYTHON_EXE="$PROJECT_DIR/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_EXE="python3"
else
  PYTHON_EXE="python"
fi

cd "$EDGE_DIR"
echo "Avvio sistema IoT: receiver + runtime + MQTT se abilitato + baseline automatica 7 giorni."
echo "Se il modello personale esiste gia, verra usato automaticamente."
exec "$PYTHON_EXE" -m edge_stack.cli --config config/edge.yml "$@"
