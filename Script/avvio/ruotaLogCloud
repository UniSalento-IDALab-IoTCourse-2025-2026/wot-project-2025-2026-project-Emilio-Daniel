#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOG_DIR="$PROJECT_DIR/cloud/mqtt/log"
MAX_BYTES="${MAX_BYTES:-10485760}"
KEEP_LAST="${KEEP_LAST:-5}"

if [[ ! -d "$LOG_DIR" ]]; then
  echo "Cartella log MQTT non presente: $LOG_DIR"
  exit 0
fi

shopt -s nullglob
for log_file in "$LOG_DIR"/*.log; do
  size="$(wc -c < "$log_file")"
  if [[ "$size" -lt "$MAX_BYTES" ]]; then
    continue
  fi

  timestamp="$(date +%Y%m%d-%H%M%S)"
  archive_file="${log_file%.log}.$timestamp.log"
  mv "$log_file" "$archive_file"
  : > "$log_file"
  echo "Ruotato log: $(basename "$archive_file")"
done

find "$LOG_DIR" -maxdepth 1 -type f -regex ".*\.[0-9]{8}-[0-9]{6}\.log" \
  | sort -r \
  | tail -n +"$((KEEP_LAST + 1))" \
  | xargs -r rm -f

echo "Rotazione log completata."
