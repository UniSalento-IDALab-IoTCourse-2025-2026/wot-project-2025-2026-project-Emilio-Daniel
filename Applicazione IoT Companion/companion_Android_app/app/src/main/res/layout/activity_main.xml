<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="15dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@color/panel"
                android:contentDescription="@string/app_logo_description"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/app_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IoT Companion"
                    android:textColor="@color/on_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Benessere e assistenza, ogni giorno"
                    android:textColor="@color/on_primary_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loginPanel"
            style="@style/Panel"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/SectionTitle"
                android:text="Bentornato" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="18dp"
                android:text="Accedi al tuo spazio personale per vedere messaggi, attività e andamento."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                style="@style/InputLabel"
                android:text="Email" />

            <EditText
                android:id="@+id/emailInput"
                style="@style/InputField"
                android:autofillHints="emailAddress"
                android:hint="nome@struttura.it"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <TextView
                style="@style/InputLabel"
                android:text="Password" />

            <EditText
                android:id="@+id/passwordInput"
                style="@style/InputField"
                android:autofillHints="password"
                android:hint="Password"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/loginButton"
                style="@style/ButtonPrimary"
                android:text="Accedi" />

            <Button
                android:id="@+id/loginAdminButton"
                style="@style/ButtonSecondary"
                android:text="Impostazioni amministrative" />

            <TextView
                android:id="@+id/loginStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/caregiverPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="1dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/caregiverWelcomeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Caregiver"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/caregiverPatientText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/caregiverRefreshButton"
                    style="@style/ButtonSecondary"
                    android:layout_width="96dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="0dp"
                    android:text="Aggiorna" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_health_status"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/caregiverStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="Monitoraggio"
                    android:textColor="@color/primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/caregiverStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Aggiornamento in corso"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/caregiverUpdateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
              </LinearLayout>

              <LinearLayout
                  style="@style/Panel"
                  android:layout_marginTop="12dp">

                  <TextView style="@style/SectionTitle" android:text="Messaggi dal team" />

                  <TextView
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="4dp"
                      android:text="Comunicazioni pratiche inviate dal medico al caregiver."
                      android:textColor="@color/text_secondary"
                      android:textSize="12sp" />

                  <LinearLayout
                      android:id="@+id/caregiverMessagesContainer"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="11dp"
                      android:orientation="vertical" />
              </LinearLayout>

              <LinearLayout
                  style="@style/Panel"
                  android:layout_marginTop="12dp">

                <TextView style="@style/SectionTitle" android:text="Segnalazioni importanti" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sono mostrati solo alert pubblicabili e autorizzati per il tuo profilo."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/caregiverAlertsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel"
                android:layout_marginTop="12dp">

                <TextView style="@style/SectionTitle" android:text="Stato tecnico semplice" />

                <TextView
                    android:id="@+id/caregiverTechnicalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/caregiverAdminSettingsButton"
                    style="@style/ButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Impostazioni" />

                <Button
                    android:id="@+id/caregiverLogoutButton"
                    style="@style/ButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Esci" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Questa vista informa e coordina il supporto familiare; la valutazione clinica resta al medico."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dailyPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="1dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/welcomeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Buongiorno"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/patientBindingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/refreshButton"
                    style="@style/ButtonSecondary"
                    android:layout_width="96dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="0dp"
                    android:text="Aggiorna" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_health_status"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/monitoringStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="Monitoraggio attivo"
                        android:textColor="@color/primary_dark"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wellnessTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Tutto procede regolarmente"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wellnessDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="I dati disponibili sono stati aggiornati."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/roomText"
                    android:layout_width="86dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Stanza\n--"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="9dp"
                android:paddingStart="3dp"
                android:text="Il tuo riepilogo"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/MetricCard"
                    android:layout_marginEnd="5dp">

                    <TextView style="@style/MetricLabel" android:text="Frequenza cardiaca" />
                    <TextView android:id="@+id/heartRateValue" style="@style/MetricValue" android:text="-- bpm" />
                    <TextView android:id="@+id/heartRateHint" style="@style/MetricLabel" android:layout_marginTop="3dp" android:text="Dato non disponibile" />
                </LinearLayout>

                <LinearLayout
                    style="@style/MetricCard"
                    android:layout_marginStart="5dp">

                    <TextView style="@style/MetricLabel" android:text="Ossigenazione" />
                    <TextView android:id="@+id/spo2Value" style="@style/MetricValue" android:text="-- %" />
                    <TextView android:id="@+id/spo2Hint" style="@style/MetricLabel" android:layout_marginTop="3dp" android:text="Dato non disponibile" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/MetricCard"
                    android:layout_marginEnd="5dp">

                    <TextView style="@style/MetricLabel" android:text="Passi rilevati" />
                    <TextView android:id="@+id/stepsValue" style="@style/MetricValue" android:text="--" />
                    <TextView android:id="@+id/stepsHint" style="@style/MetricLabel" android:layout_marginTop="3dp" android:text="Dato non disponibile" />
                </LinearLayout>

                <LinearLayout
                    style="@style/MetricCard"
                    android:layout_marginStart="5dp">

                    <TextView style="@style/MetricLabel" android:text="Sonno rilevato" />
                    <TextView android:id="@+id/sleepValue" style="@style/MetricValue" android:text="--" />
                    <TextView android:id="@+id/sleepHint" style="@style/MetricLabel" android:layout_marginTop="3dp" android:text="Dato non disponibile" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Il tuo andamento"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/trendSummaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ultime rilevazioni"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_chart_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Frequenza cardiaca media"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tocca la linea per leggere ogni valore"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <it.unisalento.iotedgecompanion.HealthTrendView
                    android:id="@+id/heartRateChart"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chart_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ossigenazione del sangue"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Vengono mostrati solo i campioni acquisiti"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <it.unisalento.iotedgecompanion.HealthTrendView
                    android:id="@+id/spo2Chart"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel"
                android:layout_marginTop="20dp">

                <TextView style="@style/SectionTitle" android:text="Messaggi dal team" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Comunicazioni e suggerimenti pensati per te."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/notificationsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel"
                android:layout_marginTop="12dp">

                <TextView style="@style/SectionTitle" android:text="Attività per te" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Questionari, check-in e promemoria assegnati dal team di cura."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/tasksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                style="@style/Panel"
                android:layout_marginTop="12dp">

                <TextView style="@style/SectionTitle" android:text="Connessioni e privacy" />

                <TextView
                    android:id="@+id/connectionStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/offlineQueueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_status"
                    android:padding="11dp"
                    android:textColor="@color/status_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/adminSettingsButton"
                    style="@style/ButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Impostazioni" />

                <Button
                    android:id="@+id/logoutButton"
                    style="@style/ButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Esci" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Queste informazioni supportano il monitoraggio e non sostituiscono il parere medico."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
