<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/backButton"
            style="@style/ButtonSecondary"
            android:layout_width="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Indietro" />

        <LinearLayout
            style="@style/Panel"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/taskTypeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/taskTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/taskInstructionsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/questionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <LinearLayout
            style="@style/Panel"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/InputLabel"
                android:text="Nota facoltativa" />

            <EditText
                android:id="@+id/taskNoteInput"
                style="@style/InputField"
                android:layout_height="96dp"
                android:gravity="top"
                android:hint="Aggiungi un commento"
                android:inputType="textMultiLine" />

            <Button
                android:id="@+id/submitTaskButton"
                style="@style/ButtonPrimary"
                android:text="Invia risposte" />

            <TextView
                android:id="@+id/taskStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
