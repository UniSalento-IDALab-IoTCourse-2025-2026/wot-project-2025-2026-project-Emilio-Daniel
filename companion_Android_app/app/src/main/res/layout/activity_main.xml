<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0"
                android:text="@string/app_name"
                android:textColor="@color/on_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0"
                android:text="Edge BLE companion"
                android:textColor="@color/on_primary_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Panel"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/SectionTitle"
                android:text="Gateway" />

            <TextView
                style="@style/InputLabel"
                android:layout_marginTop="14dp"
                android:text="Receiver Raspberry URL" />

            <EditText
                android:id="@+id/receiverUrlInput"
                style="@style/InputField"
                android:inputType="textUri"
                android:singleLine="true" />

            <TextView
                style="@style/InputLabel"
                android:text="Phone ID" />

            <EditText
                android:id="@+id/phoneIdInput"
                style="@style/InputField"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveConfigButton"
                style="@style/ButtonSecondary"
                android:layout_marginTop="10dp"
                android:text="Salva gateway" />
        </LinearLayout>

        <LinearLayout
            style="@style/Panel"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/SectionTitle"
                android:text="Mappa beacon" />

            <TextView
                android:id="@+id/beaconSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_beacon_summary"
                android:fontFamily="monospace"
                android:letterSpacing="0"
                android:minHeight="78dp"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/unlockBeaconConfigButton"
                style="@style/ButtonSecondary"
                android:text="Sblocca modifica" />

            <LinearLayout
                android:id="@+id/beaconConfigPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/beaconMapInput"
                    style="@style/InputField"
                    android:layout_height="132dp"
                    android:fontFamily="monospace"
                    android:gravity="top"
                    android:inputType="textMultiLine" />

                <Button
                    android:id="@+id/saveBeaconMapButton"
                    style="@style/ButtonPrimary"
                    android:text="Salva mappa beacon" />

                <Button
                    android:id="@+id/lockBeaconConfigButton"
                    style="@style/ButtonDanger"
                    android:text="Blocca modifica" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Panel"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/SectionTitle"
                android:text="BLE reale" />

            <Button
                android:id="@+id/startScanButton"
                style="@style/ButtonPrimary"
                android:layout_marginTop="12dp"
                android:text="Avvia monitoraggio BLE" />

            <Button
                android:id="@+id/stopScanButton"
                style="@style/ButtonSecondary"
                android:text="Ferma monitoraggio BLE" />
        </LinearLayout>

        <LinearLayout
            style="@style/Panel"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                style="@style/SectionTitle"
                android:text="Stato" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_status"
                android:letterSpacing="0"
                android:minHeight="44dp"
                android:padding="12dp"
                android:text="Pronto"
                android:textColor="@color/status_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/discoveredText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:letterSpacing="0"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
