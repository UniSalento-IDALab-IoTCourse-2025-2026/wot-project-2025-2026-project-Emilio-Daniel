IOT_BACKEND_ENVIRONMENT=test
IOT_BACKEND_LOG_LEVEL=INFO
IOT_BACKEND_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
IOT_BACKEND_AUTH_SECRET_KEY=CAMBIA_AUTH_SECRET_KEY_TEST
IOT_BACKEND_DEMO_AUTH_ENABLED=true
