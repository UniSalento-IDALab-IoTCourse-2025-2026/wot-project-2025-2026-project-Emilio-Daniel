IOT_BACKEND_ENVIRONMENT=production
IOT_BACKEND_LOG_LEVEL=INFO
IOT_BACKEND_CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://app.example.com
IOT_BACKEND_AUTH_SECRET_KEY=INSERIRE_SEGRETO_FORTE_DA_SECRET_MANAGER
IOT_BACKEND_DEMO_AUTH_ENABLED=false
IOT_BACKEND_DEMO_AUTH_PASSWORD=
IOT_BACKEND_DEMO_DOCTOR_EMAIL=
IOT_BACKEND_DEMO_CAREGIVER_EMAIL=
IOT_BACKEND_DEMO_PATIENT_EMAIL=
IOT_BACKEND_DEMO_ADMIN_EMAIL=

IOT_BACKEND_MQTT_HOST=mqtt
IOT_BACKEND_MQTT_PORT=8883
IOT_BACKEND_MQTT_USE_TLS=true
IOT_BACKEND_MQTT_USERNAME=backend
IOT_BACKEND_MQTT_PASSWORD=INSERIRE_PASSWORD_MQTT_BACKEND_DA_SECRET_MANAGER
IOT_BACKEND_MQTT_CLIENT_ID=iot-backend-subscriber
IOT_BACKEND_MQTT_CA_FILE=/mqtt/certs/ca.crt

IOT_BACKEND_DATABASE_URL=postgresql+psycopg://iot_backend:INSERIRE_PASSWORD_POSTGRES@postgres:5432/progetto_iot

IOT_BACKEND_FIREBASE_ENABLED=true
IOT_BACKEND_FIREBASE_FAKE_ENABLED=false
IOT_BACKEND_FIREBASE_CREDENTIALS_FILE=/firebase/service-account.json
IOT_BACKEND_FIREBASE_PROJECT_ID=progetto-firebase-produzione

IOT_BACKEND_EDGE_STALE_MINUTES=10
IOT_BACKEND_WATCH_STALE_MINUTES=12
IOT_BACKEND_BLE_STALE_MINUTES=12
IOT_BACKEND_GOOGLE_HEALTH_STALE_MINUTES=12
IOT_BACKEND_PATIENT_APP_STALE_MINUTES=15
